# Mems Configuration Example
# Copy this file to .env and fill in actual values

# ===================
# Database
# ===================
# PostgreSQL (default). Uses psycopg v3.
DATABASE_URL=postgresql+psycopg://mems:mems@localhost:5432/mems

# ===================
# Redis Configuration
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===================
# Qdrant Configuration
# ===================
# Optional full URL. If set, it takes precedence over host/port.
# Recommended server version for the current SDK path: Qdrant 1.15+
QDRANT_URL=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
QDRANT_HTTPS=false
QDRANT_PREFER_GRPC=false

# ===================
# Embedding Model Configuration
# ===================
# Options: sentence-transformers, openai
EMBEDDING_PROVIDER=sentence-transformers
# Used when provider=sentence-transformers
SENTENCE_TRANSFORMERS_MODEL=BAAI/bge-small-zh-v1.5
# Used when provider=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_API_KEY=

# ===================
# LLM Distillation Configuration (OpenAI-compatible)
# ===================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=300

# ===================
# Application Configuration
# ===================
APP_HOST=0.0.0.0
APP_PORT=8210
LOG_LEVEL=INFO

# ===================
# Archive Configuration
# ===================
ARCHIVE_DAYS=30
ARCHIVE_STORAGE_PATH=storage/l3_archive

# ===================
# Scheduler Configuration
# ===================
# Enable scheduler (archive job only; distillation is threshold-triggered on write)
SCHEDULER_ENABLED=true
# Run the outbox worker inside the app lifespan by default; set false to run it
# as a separate process via `python -m mems.worker`
OUTBOX_WORKER_ENABLED=true
# Poll interval for the standalone outbox worker
WORKER_POLL_SECONDS=1.0
# Distillation threshold: after each persisted write, if pending un-distilled
# records reach this count, distillation runs in the background
DISTILL_THRESHOLD=100
# Distillation batch size per agent per run
DISTILL_BATCH_SIZE=50
# Records with importance_score >= this value are distilled immediately after
# write (batch = DISTILL_IMMEDIATE_BATCH_SIZE), without waiting for the threshold
DISTILL_HIGH_IMPORTANCE_THRESHOLD=0.8
# Batch size used by the high-importance immediate distillation path
DISTILL_IMMEDIATE_BATCH_SIZE=1
# Archive cron (hour)
ARCHIVE_CRON_HOUR=3
# Archive cron (minute)
ARCHIVE_CRON_MINUTE=0

# ===================
# L3 Re-Distillation
# ===================
# Max L3 records processed per manual re-distill run (CLI or API)
REDISTILL_BATCH_SIZE=100

# L0 default TTL (seconds)
L0_DEFAULT_TTL_SECONDS=1800
# Max active L0 snapshots recalled per agent in one query
L0_RECALL_MAX_SNAPSHOTS=10

# ===================
# L0 Memory Output Pipeline (Redis Stream)
# ===================
# Enable the L0 memory output pipeline. When disabled (default), no events are
# published and no stream is created. When enabled, every L0 write/append
# publishes one event to the stream below; users can consume it with their own
# code via XREAD / XREADGROUP.
L0_PIPELINE_ENABLED=false
# Redis stream key used to output memory events
L0_PIPELINE_STREAM=mems:l0:events
# Approximate max length of the event stream (older entries are trimmed)
L0_PIPELINE_MAXLEN=10000

# ===================
# Memory Identity Recommendations
# ===================
# For multi-user agents, pass tenant_id/user_id/scope at the API layer.
# These are request-level identity fields, not environment variables.
# Recommended defaults:
# - single-user app: tenant_id=default, scope=private
# - multi-user app: always pass user_id explicitly
